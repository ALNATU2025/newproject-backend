# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed web origins (mobile apps don't need this)
CORS_ORIGINS=

# ── Database ───────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/dalabapay
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/dalabapay
MONGO_URI=mongodb://127.0.0.1:27017/dalabapay

# ── Auth ───────────────────────────────────────────────
# Use a long random string in production (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Email (verification codes) ─────────────────────────
# Leave SMTP_HOST empty in development: codes are printed in the server log
# and returned as `devCode` in the API response.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dalabapay <no-reply@dalabapay.com>"

# ── Providers ──────────────────────────────────────────
# Bill payments (airtime, data, TV, electricity, education, insurance,
# international): none | simulator   (vtpass will be added from the API docs)
BILL_PROVIDER=simulator
# Wallet funding (dedicated + one-time accounts, KYC): none | simulator
PAYMENT_PROVIDER=simulator
# Shared secret for incoming payment webhooks
WEBHOOK_SECRET=change-me

# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed web origins (mobile apps don't need this)
CORS_ORIGINS=

# ── Database ───────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/dalabapay
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/dalabapay
MONGO_URI=
# ── Auth ───────────────────────────────────────────────
# Use a long random string in production (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=90d

# ── Email (verification codes) ─────────────────────────
# Leave SMTP_HOST empty in development: codes are printed in the server log
# and returned as `devCode` in the API response.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dalabapay <no-reply@dalabapay.com>"

# ── Providers ──────────────────────────────────────────
# Bill payments (airtime, data, TV, electricity, education, insurance,
# international): none | simulator | vtpass — the default for every service
BILL_PROVIDER=simulator

# VTpass (https://vtpass.com/documentation). Profile → API Keys.
# VTPASS_SERVICES picks which services go to VTpass; the others use
# BILL_PROVIDER. Implemented so far: cable (DStv, GOtv, StarTimes) and
# international (airtime / data / PINs abroad).
VTPASS_ENV=sandbox
VTPASS_SERVICES=cable,international
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
# How long to wait for VTpass before treating a payment as pending
VTPASS_TIMEOUT_MS=45000
# Wallet funding (dedicated + one-time accounts, KYC): none | simulator
PAYMENT_PROVIDER=simulator
# Shared secret for incoming payment webhooks
WEBHOOK_SECRET=change-me

# ── Sign-up verification ───────────────────────────────
# "sms": the app sends a 6-digit SMS code through Firebase Phone Auth and
# the server checks the Firebase ID token. Needs FIREBASE_PROJECT_ID (Firebase
# console → Project settings → Project ID). Anything else: email code.
SIGNUP_VERIFICATION=email
FIREBASE_PROJECT_ID=
